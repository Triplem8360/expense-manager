APP_NAME=Expense Manager API
APP_VERSION=0.1.0
APP_DEBUG=false
SENTRY_DSN=https://public-key@sentry.example.com/1
SENTRY_ENVIRONMENT=production
SENTRY_SEND_DEFAULT_PII=true

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fa
TRANSLATION_DOMAIN=messages

# Replace these placeholders with the internal Darkube service addresses.
DATABASE_URL=postgresql+asyncpg://expense_user:replace-me@postgres-internal-host:5432/expense_db
DATABASE_ECHO=false

REDIS_URL=redis://:replace-me@redis-internal-host:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CACHE_KEY_PREFIX=expense-manager
EXPENSE_CACHE_TTL_SECONDS=300

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=expense-manager
JWT_AUDIENCE=expense-manager-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_CLOCK_SKEW_SECONDS=30

# TLS terminates at Darkube, but authentication cookies must remain Secure.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Keep one application replica while migrations run from the entrypoint.
RUN_MIGRATIONS=true
