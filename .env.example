APP_NAME=Expense Manager API
APP_VERSION=0.1.0
APP_DEBUG=false
DATABASE_URL=postgresql+asyncpg://expense_user:password@localhost:5432/expense_db
DATABASE_ECHO=false

# Generate a production secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=expense-manager
JWT_AUDIENCE=expense-manager-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_CLOCK_SKEW_SECONDS=30

# __Host- cookies require Secure=true and Path=/; serve the API through HTTPS.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
