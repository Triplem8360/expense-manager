#: src/expense_api/api/exception_handlers.py:65
msgid "A user with this email already exists"
msgstr "کاربری با این ایمیل از قبل وجود دارد."

#: src/expense_api/api/exception_handlers.py:81
#, python-format
msgid "Category already exists: %(name)s"
msgstr "دسته‌بندی از قبل وجود دارد: %(name)s"

#: src/expense_api/api/exception_handlers.py:86
#, python-format
msgid "Payment method already exists: %(code)s"
msgstr "روش پرداخت از قبل وجود دارد: %(code)s"

#: src/expense_api/api/exception_handlers.py:103
#, python-format
msgid "Expense %(expense_id)s was not found"
msgstr "هزینه با شناسه %(expense_id)s پیدا نشد."

#: src/expense_api/api/exception_handlers.py:121
#, python-format
msgid "Unknown category: %(value)s"
msgstr "دسته‌بندی ناشناخته است: %(value)s"

#: src/expense_api/api/exception_handlers.py:125
#, python-format
msgid "Unknown payment method: %(value)s"
msgstr "روش پرداخت ناشناخته است: %(value)s"

#: src/expense_api/api/exception_handlers.py:166
msgid "CSRF token is missing or invalid"
msgstr "توکن CSRF وجود ندارد یا نامعتبر است."

#: src/expense_api/api/exception_handlers.py:168
msgid "User account is inactive"
msgstr "حساب کاربری غیرفعال است."

#: src/expense_api/api/exception_handlers.py:170
msgid "Invalid email or password"
msgstr "ایمیل یا گذرواژه نامعتبر است."

#: src/expense_api/api/exception_handlers.py:172
msgid "Refresh token reuse detected"
msgstr "استفاده مجدد از توکن تازه‌سازی شناسایی شد."

#: src/expense_api/api/exception_handlers.py:175
msgid "Refresh token has expired"
msgstr "توکن تازه‌سازی منقضی شده است."

#: src/expense_api/api/exception_handlers.py:176
msgid "Access token has expired"
msgstr "توکن دسترسی منقضی شده است."

#: src/expense_api/api/exception_handlers.py:179
msgid "Refresh token is invalid"
msgstr "توکن تازه‌سازی نامعتبر است."

#: src/expense_api/api/exception_handlers.py:180
msgid "Access token is invalid"
msgstr "توکن دسترسی نامعتبر است."

#: src/expense_api/api/exception_handlers.py:181
msgid "Authentication failed"
msgstr "احراز هویت ناموفق بود."

#: src/expense_api/api/v1/localization.py:22
msgid "Welcome to the Expense Manager API."
msgstr "به رابط برنامه‌نویسی مدیریت هزینه خوش آمدید."

#: src/expense_api/api/v1/localization.py:39
msgid "The service is running."
msgstr "سرویس در حال اجرا است."
