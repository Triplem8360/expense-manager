msgid "Welcome to the Expense Manager API."
msgstr "به رابط برنامه‌نویسی مدیریت هزینه خوش آمدید."

msgid "The service is running."
msgstr "سرویس در حال اجرا است."

msgid "Expense created successfully."
msgstr "هزینه با موفقیت ایجاد شد."

msgid "Expense updated successfully."
msgstr "هزینه با موفقیت به‌روزرسانی شد."

msgid "Expense deleted successfully."
msgstr "هزینه با موفقیت حذف شد."

msgid "Authentication required."
msgstr "احراز هویت الزامی است."

msgid "Invalid or expired token."
msgstr "توکن نامعتبر یا منقضی شده است."

msgid "Requested language is not supported."
msgstr "زبان درخواستی پشتیبانی نمی‌شود."
