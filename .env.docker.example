APP_NAME=Expense Manager API
APP_VERSION=0.1.0
APP_DEBUG=false

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fa
TRANSLATION_DOMAIN=messages

POSTGRES_DB=expense_db
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql+asyncpg://expense_user:replace-this-database-password@postgres:5432/expense_db
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CACHE_KEY_PREFIX=expense-manager
EXPENSE_CACHE_TTL_SECONDS=300

# Generate a production secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=expense-manager
JWT_AUDIENCE=expense-manager-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_CLOCK_SKEW_SECONDS=30

# __Host- cookies require HTTPS outside local development.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Locust load-test configuration
LOCUST_WEB_PORT=8089
LOCUST_TARGET_HOST=http://api:8000
LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=LoadTestPassword123
LOAD_TEST_EXPENSE_ID=
LOAD_TEST_MAX_FAILURE_RATIO=0.01
LOAD_TEST_MAX_AVG_RESPONSE_MS=500
LOAD_TEST_MAX_P95_RESPONSE_MS=1000
